# Copy to .env (never commit .env). All secrets are server-side only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/quantara?schema=public"
BETTER_AUTH_SECRET=""        # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
APP_ENCRYPTION_KEY=""        # 32-byte base64; encrypts admin-entered provider keys at rest
# AI providers (leave blank = provider disabled; Council shows "service unavailable")
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Email / storage / analytics: blank = integration reports "not configured"
RESEND_API_KEY=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
TURNSTILE_SECRET_KEY=""
SENTRY_DSN=""

# Random secret used to hash visitor IP addresses for abuse limiting (required in production).
# Generate with: openssl rand -hex 32
APP_IP_HASH_SALT=

# Sender address for transactional email (verification, password reset). Must be on a domain verified in Resend.
MAIL_FROM=

# Where uploaded resumes are stored. Must be a private, persistent directory that the website does not serve.
# Leave empty in development (uses apps/web/.data/resumes). REQUIRED in production.
RESUME_STORAGE_DIR=
