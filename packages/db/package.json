{
  "name": "@quantara/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": { ".": "./src/index.ts", "./seed-data": "./src/seed/index.ts" },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "@quantara/content": "workspace:*"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1",
    "@types/pg": "^8.15.0",
    "@types/node": "^22.0.0",
    "dotenv": "^17.0.0"
  }
}
